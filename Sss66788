	fovCircle.Size = UDim2.new(0, fovRadius * 2, 0, fovRadius * 2)
	fovLbl.Text = "FOV: " .. fovRadius .. "px"
end)

-- Tables to manage ESP drawings for all players
local highlights = {}
local boxes = {}
local lines = {}

-- 6. Main Game Loop (Highlights Everyone, Box ESP, Line ESP & Closest Target Lock)
RunService.RenderStepped:Connect(function()
	local screenCenter = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
	local closestPlayer = nil
	local shortestDist = math.huge

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= plr then
			local char = p.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")

			-- Highlight Every Player in Red Automatically
			if char and hum and hum.Health > 0 then
				if not highlights[p] or highlights[p].Parent ~= char then
					if highlights[p] then highlights[p]:Destroy() end
					highlights[p] = mk("Highlight", char, {
						FillColor = Color3.fromRGB(255, 0, 0),
						OutlineColor = Color3.fromRGB(255, 255, 255)
					})
				end

				-- Box ESP & Line ESP setup
				local pos, onScreen = cam:WorldToViewportPoint(hrp.Position)
				if onScreen then
					-- Create/Update Box ESP
					if not boxes[p] then
						boxes[p] = mk("Frame", gui, {BackgroundTransparency = 1})
						mk("UIStroke", boxes[p], {Thickness = 1.5, Color = Color3.fromRGB(255, 0, 0)})
					end
					local sizeY = math.clamp(2000 / pos.Z, 20, 400)
					local sizeX = sizeY * 0.55
					boxes[p].Size = UDim2.new(0, sizeX, 0, sizeY)
					boxes[p].Position = UDim2.new(0, pos.X - sizeX/2, 0, pos.Y - sizeY/2)
					boxes[p].Visible = true

					-- Create/Update Line ESP (Tracers)
					if not lines[p] then
						lines[p] = mk("Frame", gui, {BackgroundColor3 = Color3.fromRGB(255, 0, 0), Size = UDim2.new(0, 1, 0, 1)})
					end
					local bottomScreenPos = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
					local targetPos2D = Vector2.new(pos.X, pos.Y)
					local distToBottom = (targetPos2D - bottomScreenPos).Magnitude
					lines[p].Size = UDim2.new(0, 1, 0, distToBottom)
					lines[p].Position = UDim2.new(0, bottomScreenPos.X, 0, bottomScreenPos.Y)
					lines[p].Visible = true

					-- Closest Target Selection inside FOV
					if isEnabled then
						local distFromCenter = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
						if distFromCenter <= fovRadius then
							local visible = true
							if wallCheck then
								local params = RaycastParams.new()
								params.FilterDescendantsInstances = {plr.Character, char}
								params.FilterType = Enum.RaycastFilterType.Exclude
								if workspace:Raycast(cam.CFrame.Position, hrp.Position - cam.CFrame.Position, params) then
									visible = false
								end
							end
							if visible and distFromCenter < shortestDist then
								shortestDist = distFromCenter
								closestPlayer = p
							end
						end
					end
				else
					if boxes[p] then boxes[p].Visible = false end
					if lines[p] then lines[p].Visible = false end
				end
			else
				if highlights[p] then highlights[p]:Destroy(); highlights[p] = nil end
				if boxes[p] then boxes[p]:Destroy(); boxes[p] = nil end
				if lines[p] then lines[p]:Destroy(); lines[p] = nil end
			end
		end
	end

	-- Apply Closest Target Lock
	currentTarget = closestPlayer
	if isEnabled then
		nameLbl.Text = currentTarget and ("Target: " .. currentTarget.Name) or "Target: Searching..."
		if currentTarget and currentTarget.Character and currentTarget.Character:FindFirstChild("HumanoidRootPart") then
			local hrp = currentTarget.Character.HumanoidRootPart
			cam.CFrame = CFrame.new(cam.CFrame.Position, hrp.Position + Vector3.new(0, 1.5, 0))
		end
	end
end)
