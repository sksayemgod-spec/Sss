-- 2. Main Menu Panel
local panel = mk("Frame", gui, {
	Size = UDim2.new(0, 180, 0, 195),
	Position = UDim2.new(0.02, 60, 0.7, 0),
	BackgroundColor3 = Color3.fromRGB(15, 15, 15),
