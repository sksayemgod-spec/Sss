-- 3. Custom Drag & Click Handler (Fixes open/close and allows smooth dragging anywhere)
local dragging = false
local dragStart, startPos
local hasMoved = false

openBtn.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = openBtn.Position
		hasMoved = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		if delta.Magnitude > 5 then
			hasMoved = true
		end
		openBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		panel.Position = UDim2.new(openBtn.Position.X.Scale, openBtn.Position.X.Offset + 65, openBtn.Position.Y.Scale, openBtn.Position.Y.Offset)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		if dragging then
			dragging = false
			-- If it wasn't dragged around, treat it as a click to open/close!
			if not hasMoved then
				isOpen = not isOpen
				if isOpen then
					panel.Visible = true
					panel.Size = UDim2.new(0, 0, 0, 0)
					TweenService:Create(panel, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 180, 0, 195)}):Play()
				else
					local tween = TweenService:Create(panel, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = UDim2.new(0, 0, 0, 0)})
					tween:Play()
					tween.Completed:Connect(function()
						if not isOpen then panel.Visible = false end
					end)
				end
			end
		end
	end
end)

