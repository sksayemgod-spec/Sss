-- 7. Main Game Loop (Targeting, Highlights & Camera Lock)
RunService.RenderStepped:Connect(function()
	-- Highlight Target in Red
	if currentTarget and currentTarget.Character then
		if not activeHighlight or activeHighlight.Parent ~= currentTarget.Character then
			if activeHighlight then activeHighlight:Destroy() end
			activeHighlight = mk("Highlight", currentTarget.Character, {
				FillColor = Color3.fromRGB(255, 0, 0),
				OutlineColor = Color3.fromRGB(255, 255, 255)
			})
		end
	else
		if activeHighlight then 
			activeHighlight:Destroy() 
			activeHighlight = nil 
		end
	end

	if not isEnabled then return end

	-- Find Random Target within FOV Circle
	if not currentTarget or not currentTarget.Character or not currentTarget.Character:FindFirstChild("HumanoidRootPart") then
		local validTargets = {}
		local screenCenter = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
		
		for _, player in ipairs(Players:GetPlayers()) do
			local char = player.Character
			if player ~= plr and char and char:FindFirstChild("HumanoidRootPart") then
				local humanoid = char:FindFirstChildOfClass("Humanoid")
				if humanoid and humanoid.Health > 0 then
					local rootPart = char.HumanoidRootPart
					local screenPoint, onScreen = cam:WorldToViewportPoint(rootPart.Position)
					
					if onScreen and (Vector2.new(screenPoint.X, screenPoint.Y) - screenCenter).Magnitude <= fovRadius then
						local visible = true
						if wallCheck then
							local params = RaycastParams.new()
							params.FilterDescendantsInstances = {plr.Character, char}
							params.FilterType = Enum.RaycastFilterType.Exclude
							if workspace:Raycast(cam.CFrame.Position, rootPart.Position - cam.CFrame.Position, params) then
								visible = false
							end
						end
						if visible then
							table.insert(validTargets, player)
						end
					end
				end
			end
		end
		
		currentTarget = #validTargets > 0 and validTargets[math.random(1, #validTargets)] or nil
		nameLbl.Text = currentTarget and ("Target: " .. currentTarget.Name) or "Target: Searching..."
	end

	-- Lock Camera onto Selected Target
	if currentTarget and currentTarget.Character then
		local rootPart = currentTarget.Character:FindFirstChild("HumanoidRootPart")
		if rootPart then
			local screenPoint, onScreen = cam:WorldToViewportPoint(rootPart.Position)
			local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
			
			if onScreen and (Vector2.new(screenPoint.X, screenPoint.Y) - center).Magnitude <= fovRadius * 1.5 then
				cam.CFrame = CFrame.new(cam.CFrame.Position, rootPart.Position + Vector3.new(0, 1.5, 0))
			else
				currentTarget = nil
			end
		else
			currentTarget = nil
		end
	else
		currentTarget = nil
	end
end)
